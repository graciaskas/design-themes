<?xml version="1.0" encoding="utf-8" ?>
<odoo>

     <!-- === Services Page === -->
     <record id="rooms_page" model="website.page">
         <field name="name">Rooms page</field>
         <field name="website_published">True</field>
         <field name="url">/rooms</field>
         <field name="type">qweb</field>
         <field name="key">theme_hiroto.rooms_page</field>
         <field name="arch" type="xml">
             <t t-name="theme_hiroto.rooms_page_template">
                 <t t-call="website.layout">
                    <div id="wrap">
                        <div class="oe_structure">
                         <!-- Breadcrumb Begin -->
                        <section>
                            <div class="breadcrumb-option set-bg" data-setbg="/theme_hiroto/static/src/img/breadcrumb-bg.jpg">
                                <div class="container">
                                    <div class="row">
                                        <div class="col-lg-12 text-center">
                                            <div class="breadcrumb__text">
                                                <h1>Our Rooms</h1>
                                                <div class="breadcrumb__links">
                                                    <a href="/">Home</a>
                                                    <span>Rooms</span>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <div class="col-lg-12 py-3">
                                            <form id="book__form" action="/rooms/check" method="post" class="filter__form">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <div class="filter__form__item filter__form__item--search">
                                                    <p>Room</p>
                                                    <div class="filter__form__input">
                                                        <input type="text" placeholder="Search Room"/>
                                                        <span class="icon_search"></span>
                                                    </div>
                                                </div>
                                                <div class="filter__form__item">
                                                    <p>Check In</p>
                                                    <div class="filter__form__datepicker">
                                                        <span class="icon_calendar"></span>
                                                        <input t-att-min='today' type="text" class="datepicker_pop check__in" id="checkin_date" name="checkin_date" required="1"/>
                                                        <i class="arrow_carrot-down"></i>
                                                    </div>
                                                </div>
                                                <div class="filter__form__item">
                                                    <p>Check Out</p>
                                                    <div class="filter__form__datepicker">
                                                        <span class="icon_calendar"></span>
                                                        <input t-att-min='today' type="text" id="checkout_date" name="checkout_date" required="1" class="datepicker_pop check__out"/>
                                                        <i class="arrow_carrot-down"></i>
                                                    </div>
                                                </div>
                                                <div class="filter__form__item filter__form__item--select" name="category_select">
                                                    <p>Category</p>
                                                    <div class="filter__form__select">
                                                        <span class="icon_group"></span>
                                                        <select id="room_type" name="room_type">
                                                            <option value="">2 Adult, 1 Children</option>
                                                            <option value="">2 Adult</option>
                                                            <option value="">1 Adult</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <button type="submit">BOOK NOW</button>
                                            </form>
                                                </div>
                                    </div>
                                </div>
                            </div>
                        </section>
    <!-- Breadcrumb End -->

    <!-- Rooms Section Begin -->
    <section class="rooms spad">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 p-0 order-lg-2 order-md-2 col-md-6">
                    <div class="room__pic__slider owl-carousel">
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-1.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-2.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-3.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-4.jpg"></div>
                    </div>
                </div>
                <div class="col-lg-6 p-0 order-lg-1 order-md-1 col-md-6">
                    <div class="room__text">
                        <h3>Premium King Room</h3>
                        <h2><sup>$</sup>99<span>/day</span></h2>
                        <ul>
                            <li><span>Size:</span>30 ft</li>
                            <li><span>Capacity:</span>Max persion 3</li>
                            <li><span>Bed:</span>King Beds</li>
                            <li><span>Services:</span>Wifi, Television, Bathroom,...</li>
                            <li><span>View:</span>Sea View</li>
                        </ul>
                        <a href="#">View Details</a>
                    </div>
                </div>
                <div class="col-lg-6 p-0 order-lg-3 order-md-3 col-md-6">
                    <div class="room__pic__slider owl-carousel">
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-2.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-3.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-4.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-1.jpg"></div>
                    </div>
                </div>
                <div class="col-lg-6 p-0 order-lg-4 order-md-4 col-md-6">
                    <div class="room__text right__text">
                        <h3>Deluxe Room</h3>
                        <h2><sup>$</sup>86<span>/day</span></h2>
                        <ul>
                            <li><span>Size:</span>30 ft</li>
                            <li><span>Capacity:</span>Max persion 3</li>
                            <li><span>Bed:</span>King Beds</li>
                            <li><span>Services:</span>Wifi, Television, Bathroom,...</li>
                            <li><span>View:</span>Sea View</li>
                        </ul>
                        <a href="#">View Details</a>
                    </div>
                </div>
                <div class="col-lg-6 p-0 order-lg-6 order-md-6 col-md-6">
                    <div class="room__pic__slider owl-carousel">
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-3.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-4.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-2.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-1.jpg"></div>
                    </div>
                </div>
                <div class="col-lg-6 p-0 order-lg-5 order-md-5 col-md-6">
                    <div class="room__text">
                        <h3>Double Room</h3>
                        <h2><sup>$</sup>71<span>/day</span></h2>
                        <ul>
                            <li><span>Size:</span>30 ft</li>
                            <li><span>Capacity:</span>Max persion 3</li>
                            <li><span>Bed:</span>King Beds</li>
                            <li><span>Services:</span>Wifi, Television, Bathroom,...</li>
                            <li><span>View:</span>Sea View</li>
                        </ul>
                        <a href="#">View Details</a>
                    </div>
                </div>
                <div class="col-lg-6 p-0 order-lg-7 order-md-7 col-md-6">
                    <div class="room__pic__slider owl-carousel">
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-4.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-1.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-2.jpg"></div>
                        <div class="room__pic__item set-bg" data-setbg="/theme_hiroto/static/src/img/rooms/room-3.jpg"></div>
                    </div>
                </div>
                <div class="col-lg-6 p-0 order-lg-8 order-md-8 col-md-6">
                    <div class="room__text right__text">
                        <h3>Luxury Room</h3>
                        <h2><sup>$</sup>79<span>/day</span></h2>
                        <ul>
                            <li><span>Size:</span>30 ft</li>
                            <li><span>Capacity:</span>Max persion 3</li>
                            <li><span>Bed:</span>King Beds</li>
                            <li><span>Services:</span>Wifi, Television, Bathroom,...</li>
                            <li><span>View:</span>Sea View</li>
                        </ul>
                        <a href="#">View Details</a>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12">
                    <div class="pagination__number">
                        <a href="#">1</a>
                        <a href="#">2</a>
                        <a href="#">Next <span class="arrow_right"></span></a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Rooms Section End -->

                      
                       </div>
                    </div>
                </t>
             </t>
         </field>
     </record>

    <record id="rooms_page_link" model="website.menu">
        <field name="name">Rooms</field>
        <field name="page_id" ref="theme_hiroto.rooms_page"/>
        <field name="parent_id" ref="website.main_menu" />
        <field name="sequence" type="int">100</field>
    </record>

 </odoo>