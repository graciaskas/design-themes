<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <template id="homepage" inherit_id="website.homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap">
                <div class="oe_structure"/>
                
                <!-- Hero Section Begin -->
                <section class="hero spad set-bg" data-setbg="/theme_hiroto/static/src/img/hero.jpg">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="hero__text">
                                    <h5>BIENVENUE CHEZ CHIFE</h5>
                                    <h2>Vivez des vacances exceptionnelles chez nous.</h2>
                                </div>
                                <form id="book__form" action="/rooms/check" method="post" class="filter__form">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div class="filter__form__item filter__form__item--search">
                                        <p>Catégorie</p>
                                        <div class="filter__form__input">
                                            <input type="text" placeholder="Catégorie "/>
                                            <span class="icon_search"></span>
                                        </div>
                                    </div>
                                    <div class="filter__form__item">
                                        <p>Arrivé</p>
                                        <div class="filter__form__datepicker">
                                            <span class="icon_calendar"></span>
                                            <input t-att-min='today' type="text" class="datepicker_pop check__in" id="checkin_date" name="checkin_date" required="1"/>
                                            <i class="arrow_carrot-down"></i>
                                        </div>
                                    </div>
                                    <div class="filter__form__item">
                                        <p>Départ</p>
                                        <div class="filter__form__datepicker">
                                            <span class="icon_calendar"></span>
                                            <input t-att-min='today' type="text" id="checkout_date" name="checkout_date" required="1" class="datepicker_pop check__out"/>
                                            <i class="arrow_carrot-down"></i>
                                        </div>
                                    </div>
                                    <div class="filter__form__item filter__form__item--select" name="category_select">
                                        <p>Adultes</p>
                                        <div class="filter__form__select">
                                            <span class="icon_group"></span>
                                            <select id="room_type" name="room_type">
                                                <option value="">2 Adult, 1 Children</option>
                                                <option value="">2 Adult</option>
                                                <option value="">1 Adult</option>
                                            </select>
                                        </div>
                                    </div>
                                    <button type="submit">BOOK NOW</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </section>
                

            <!-- Home About Section Begin -->
            <section class="home-about">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="home__about__text">
                                <div class="section-title">
                                    <h5>À PROPOS DE NOUS</h5>
                                    <h2>Bienvenue chez Chife Hotel</h2>
                                </div>
                                <p class="first-para">
                                   Bienvenue chez Chife Hotel, votre résidence de choix à Goma. Notre mission est simple : transformer votre voyage en 
                                   un souvenir mémorable. 
                                </p>
                                
                                <p class="last-para">
                                    Niché dans un cadre sécurisé et 
                                   apaisant, l'hôtel a été pensé pour être votre "chez-vous" loin de chez vous.
                                .</p>
                                <img src="/theme_hiroto/static/src/img/home-about/sign.png" alt=""/>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="home__about__pic">
                                <img src="/theme_hiroto/static/src/img/home-about/home-about.png" alt=""/>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            <!-- Home About Section End -->

            <!-- Services Section Begin -->
            <section class="services spad">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-6">
                            <div class="services__item">
                                <img src="/theme_hiroto/static/src/img/services/services-1.png" alt=""/>
                                <h4>Wi-Fi Gratuit</h4>
                                <p>
                                    Chez Chife Hotel, nous savons que la connectivité est essentielle pour vos affaires et vos échanges. Profitez d'un accès Wi-Fi haut débit gratuit et illimité 
                                    dans l'ensemble de notre établissement.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6">
                            <div class="services__item">
                                <img src="/theme_hiroto/static/src/img/services/services-2.png" alt=""/>
                                <h4>Piscine Premium</h4>
                                <p>
                                    La piscine du Chife Hotel redéfinit le luxe à Goma. Conçue pour nos hôtes les plus exigeants, 
                                    elle allie design moderne et confort haut de gamme.
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6">
                            <div class="services__item">
                                <img src="/theme_hiroto/static/src/img/services/services-3.png" alt=""/>
                                <h4>Cafetière</h4>
